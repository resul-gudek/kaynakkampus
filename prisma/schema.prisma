// Kaynak Akademi — Koçluk Sistemi veri modeli (MSSQL)
// Not: Prisma sqlserver enum desteklemez; durum/rol alanları String'dir ve
// zod (src/lib/dogrulama.ts) + migration'a elle eklenen CHECK constraint'lerle doğrulanır.
// Kullanici'ye çift FK (ogrenciId+kocId) ve self-FK nedeniyle SQL Server çoklu
// cascade yolu kabul etmez → tüm kullanıcı ilişkileri NoAction; silmeler app
// tarafında $transaction ile yapılır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Kullanici {
  id        String  @id @default(cuid())
  rol       String // "admin" | "koc" | "ogrenci" | "veli"
  ad        String
  kullanici String  @unique // tr-TR küçük harfe normalize edilmiş kullanıcı adı
  sifreHash String
  aktif     Boolean @default(true)

  // koç alanı
  brans String?

  // öğrenci alanları
  sinif       String?
  hedef       String?
  kocId       String?
  koc         Kullanici?  @relation("KocOgrenci", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ogrenciler  Kullanici[] @relation("KocOgrenci")

  // veli ilişkisi: öğrenci → veli (bir veli birden çok çocuğa bakabilir)
  veliId   String?
  veli     Kullanici?  @relation("VeliOgrenci", fields: [veliId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cocuklar Kullanici[] @relation("VeliOgrenci")

  telefon     String      @default("")
  veliTelefon String      @default("")
  eposta      String      @default("") // hoş geldin / ders hatırlatma mailleri için (opsiyonel)
  profil      String?     @db.NVarChar(Max) // başlangıç seviye profili (JSON, zod ProfilSemasi)

  olusturma  DateTime  @default(now())
  sonGorulme DateTime? // son istek zamanı (çevrimiçi tespiti; aktifKullanici içinde güncellenir)

  odevlerOgrenci  Odev[]           @relation("OdevOgrenci")
  odevlerKoc      Odev[]           @relation("OdevKoc")
  takipOgrenci    Takip[]          @relation("TakipOgrenci")
  takipKoc        Takip[]          @relation("TakipKoc")
  denemeler       Deneme[]
  yolOgrenci      YolAdimi[]       @relation("YolOgrenci")
  yolKoc          YolAdimi[]       @relation("YolKoc")
  ozelDersOgrenci OzelDers[]       @relation("OzelDersOgrenci")
  ozelDersKoc     OzelDers[]       @relation("OzelDersKoc")
  onlineSiniflar  OnlineSinif[]    @relation("OnlineSinifOgretmen")
  sinifUyelikleri OnlineSinifUye[]
  dersKatilimlari DersKatilim[]
  bildirimler     Bildirim[]
  girisKayitlari  GirisKaydi[]
  mesajGonderilen Mesaj[]          @relation("MesajGonderen")
  mesajAlinan     Mesaj[]          @relation("MesajAlici")
  pushAbonelikleri PushAbonelik[]
  bildirimTercihleri BildirimTercih[]
  sureliTestler   SureliTest[]       @relation("SureliTestKoc")
  testAtamalari   SureliTestAtama[]  @relation("SureliTestAtamaOgrenci")
  testOturumlari  SureliTestOturum[] @relation("SureliTestOturumOgrenci")
  videoDersleri   VideoDers[]        @relation("VideoDersOgretmen")
  videoAtamalari  VideoAtama[]       @relation("VideoAtamaOgrenci")
  videoIzlemeleri VideoIzleme[]      @relation("VideoIzlemeOgrenci")
  odemelerOgrenci Odeme[]            @relation("OdemeOgrenci")
  odemelerKoc     Odeme[]            @relation("OdemeKoc")
}

// ── Web Push abonelikleri ────────────────────────────────────
// Kullanicinin push izni verdigi her cihaz/tarayici bir kayittir.
// Gonderim basarisiz olursa (410/404) kayit budanir.
model PushAbonelik {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  endpoint    String    @db.NVarChar(1000)
  p256dh      String    @db.NVarChar(400)
  auth        String    @db.NVarChar(400)
  tarayici    String    @default("") @db.NVarChar(400) // user-agent (bilgi amacli)
  olusturma   DateTime  @default(now())

  @@index([kullaniciId])
}

// Kullanıcının kendi bildirim tercihleri. Satır YOKSA o tür AÇIK sayılır
// (opt-out) — böylece yeni bir tür eklendiğinde kimse bildirimsiz kalmaz.
// Uygulama içi bildirim her zaman yazılır (kayıt/denetim izi); tercih yalnız
// cihaza gidecek push'u yönetir. Türler: bkz. src/lib/bildirim-tercih.ts
model BildirimTercih {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tur         String // "odev" | "oturum" | "sinif" | "ozel" | "test" | "video" | "genel"
  push        Boolean   @default(true)
  guncelleme  DateTime  @default(now()) @updatedAt

  @@unique([kullaniciId, tur])
}

// ── Mesajlaşma ───────────────────────────────────────────────
// Koç ↔ öğrenci arası çift yönlü mesajlar. Bir konuşma iki kullanıcı
// arasındaki tüm mesajların tarih sırasıdır; ayrı "Konusma" tablosu yok.
model Mesaj {
  id         String    @id @default(cuid())
  gonderenId String
  aliciId    String
  gonderen   Kullanici @relation("MesajGonderen", fields: [gonderenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alici      Kullanici @relation("MesajAlici", fields: [aliciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  govde      String    @db.NVarChar(Max)
  okundu     Boolean   @default(false)
  tarih      DateTime  @default(now())

  @@index([aliciId, okundu])
  @@index([gonderenId, aliciId, tarih])
}

// ── Kullanıcı aktivite izleme ────────────────────────────────
// Her başarılı giriş bir kayıt üretir (admin panelindeki aktivite modülü).
model GirisKaydi {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zaman       DateTime  @default(now())
  ip          String    @default("")
  tarayici    String    @default("") @db.NVarChar(Max) // user-agent

  @@index([kullaniciId, zaman])
  @@index([zaman])
}

model Odev {
  id         String    @id @default(cuid())
  ogrenciId  String
  kocId      String
  ogrenci    Kullanici @relation("OdevOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  koc        Kullanici @relation("OdevKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ders       String
  konu       String
  aciklama   String    @default("") @db.NVarChar(Max)
  kaynak     String    @default("")
  soruSayisi Int?
  sonTarih   DateTime? @db.Date
  durum      String    @default("bekliyor") // "bekliyor" | "tamamlandi"
  olusturma  DateTime  @default(now())
  kanitlar   OdevKanit[]

  @@index([ogrenciId])
  @@index([kocId])
}

// Öğrencinin ödevi tamamladığını gösteren kanıt fotoğrafı (defter/çözüm sayfası).
// Dosyalar public DIŞI dizinde tutulur; yalnız /api/odev/kanit/[id] üzerinden
// ödevin öğrencisine, koçuna ve admin'e sunulur.
model OdevKanit {
  id        String   @id @default(cuid())
  odevId    String
  odev      Odev     @relation(fields: [odevId], references: [id], onDelete: Cascade)
  ad        String // orijinal dosya adı (yalnız görüntüleme için)
  yol       String   @db.NVarChar(1000) // saklama köküne göreli yol (public DIŞI)
  tur       String   @default("") // MIME türü
  boyut     Int      @default(0) // bayt
  olusturma DateTime @default(now())

  @@index([odevId])
}

// ── Süreli testler ───────────────────────────────────────────
// Öğretmen testi bir kez tanımlar (soru bankası) ve seçtiği öğrencilere atar;
// öğrenci testi başlattığında SureliTestOturum açılır.
// Süre otoritesi SUNUCUDADIR: oturum açılırken bitisSiniri = baslangic + sure
// yazılır; istemcideki sayaç yalnız bu ana göre geri sayar, puanlama ve süre
// kontrolü daima sunucuda yapılır (bkz. src/lib/sureli-test-sunucu.ts).
// Doğru cevaplar (SureliTestSoru.dogru) test bitene kadar istemciye GİTMEZ.
model SureliTest {
  id         String             @id @default(cuid())
  kocId      String
  koc        Kullanici          @relation("SureliTestKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ad         String
  ders       String
  konu       String             @default("")
  seviye     String             @default("") // sınıf seviyesi (SINIF_SEVIYELERI); "" = seviye belirtilmedi
  soruSayisi Int // soru satırı sayısıyla aynı olmalı (zod ile doğrulanır)
  sure       Int // dakika
  aktif      Boolean            @default(true) // pasif test öğrenciye görünmez
  olusturma  DateTime           @default(now())
  sorular    SureliTestSoru[]
  atamalar   SureliTestAtama[]
  oturumlar  SureliTestOturum[]

  @@index([kocId, aktif])
}

model SureliTestSoru {
  id         String     @id @default(cuid())
  testId     String
  test       SureliTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  sira       Int // 1'den başlar
  metin      String     @db.NVarChar(Max)
  secenekler String     @default("[]") @db.NVarChar(Max) // JSON string dizisi; sıra A, B, C… ile eşleşir
  dogru      String // "A" | "B" | "C" | "D" | "E" (bkz. TEST_SECENEKLERI)

  @@unique([testId, sira])
}

// Testin bir öğrenciye atanması. Öğrenci yalnız kendisine atanmış testleri görür.
model SureliTestAtama {
  id        String     @id @default(cuid())
  testId    String
  ogrenciId String
  test      SureliTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  ogrenci   Kullanici  @relation("SureliTestAtamaOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sonTarih  DateTime?  @db.Date // opsiyonel teslim tarihi (yalnız bilgi/sıralama amaçlı)
  olusturma DateTime   @default(now())

  @@unique([testId, ogrenciId])
  @@index([ogrenciId])
}

// Öğrencinin bir test denemesi. Cevaplar çözüm sırasında da kaydedilir
// (cevaplar JSON) — sekme kapanırsa süre dolduğunda kayıtlı cevaplar puanlanır.
model SureliTestOturum {
  id          String     @id @default(cuid())
  testId      String
  ogrenciId   String
  test        SureliTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  ogrenci     Kullanici  @relation("SureliTestOturumOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  baslangic   DateTime   @default(now())
  bitisSiniri DateTime // baslangic + sure (dk) — süre otoritesi
  bitis       DateTime? // testin kapandığı an
  gecenSure   Int? // tamamlama süresi (saniye)
  durum       String     @default("basladi") // "basladi" | "tamamlandi" | "sureDoldu"
  dogru       Int        @default(0)
  yanlis      Int        @default(0)
  bos         Int        @default(0)
  yuzde       Int        @default(0) // başarı yüzdesi (0..100)
  cevaplar    String     @default("{}") @db.NVarChar(Max) // { soruId: "A" }

  @@index([ogrenciId, durum])
  @@index([testId])
}

model Takip {
  id         String    @id @default(cuid())
  ogrenciId  String
  kocId      String
  ogrenci    Kullanici @relation("TakipOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  koc        Kullanici @relation("TakipKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gun        String // "Pazartesi" … "Pazar"
  gorev      String    @db.NVarChar(Max)
  tamamlandi Boolean   @default(false)

  @@index([ogrenciId])
}

model Deneme {
  id        String       @id @default(cuid())
  ogrenciId String
  ogrenci   Kullanici    @relation(fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ad        String
  tur       String // "TYT" | "AYT" | "LGS" | "Branş"
  tarih     DateTime     @db.Date
  net       Float // toplam net
  dersler   DenemeDers[]

  @@index([ogrenciId])
}

model DenemeDers {
  id            String @id @default(cuid())
  denemeId      String
  deneme        Deneme @relation(fields: [denemeId], references: [id], onDelete: Cascade)
  ders          String
  dogru         Int
  yanlis        Int
  bos           Int
  net           Float
  yanlisKonular String @default("[]") @db.NVarChar(Max) // JSON string dizisi

  @@index([denemeId])
}

model YolAdimi {
  id         String    @id @default(cuid())
  ogrenciId  String
  kocId      String
  ogrenci    Kullanici @relation("YolOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  koc        Kullanici @relation("YolKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sira       Int
  ders       String
  konu       String
  hedef      String    @default("")
  xp         Int       @default(50)
  tamamlandi Boolean   @default(false)

  @@unique([ogrenciId, sira])
}

model OzelDers {
  id        String        @id @default(cuid())
  ogrenciId String
  kocId     String
  ogrenci   Kullanici     @relation("OzelDersOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  koc       Kullanici     @relation("OzelDersKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ders      String
  konu      String        @default("")
  tarih     DateTime      @db.Date
  saat      String        @default("") // "18:00"
  sure      Int           @default(60) // dakika
  ucret     Int           @default(0) // ₺
  odendi    Boolean       @default(false)
  durum     String        @default("planlandi") // "talep" | "planlandi" | "yapildi" | "reddedildi" | "iptal"
  olusturan String        @default("koc") // "koc" | "ogrenci"
  mesaj     String        @default("") @db.NVarChar(Max) // talep notu
  redNotu   String        @default("") @db.NVarChar(Max)
  not_      String        @default("") @map("not") @db.NVarChar(Max) // ders sonrası not
  odev      String        @default("") @db.NVarChar(Max) // ders ödevi
  olusturma DateTime      @default(now())
  oturumlar DersOturumu[]
  degerlendirmeler DersDegerlendirme[]

  @@index([ogrenciId])
  @@index([kocId])
}

// ── Ders sonrası karşılıklı değerlendirme ────────────────────
// Tamamlanan ("yapildi") her özel ders için iki yönde en çok birer kayıt:
// yon="kocOgrenci" (öğretmen öğrenciyi) ve yon="ogrenciKoc" (öğrenci öğretmeni).
// Yapılandırılmış cevaplar veri içinde JSON tutulur (zod ile doğrulanır —
// bkz. src/lib/dogrulama.ts); genel puan raporlama için ayrı kolondur.
// Kullanici'ye FK yok (SQL Server çoklu-cascade tuzağı; BasvuruNot deseni):
// yazarId/hedefId düz string. Ders silinince değerlendirmeler cascade silinir.
model DersDegerlendirme {
  id         String   @id @default(cuid())
  ozelDersId String
  ozelDers   OzelDers @relation(fields: [ozelDersId], references: [id], onDelete: Cascade)
  yon        String // "kocOgrenci" | "ogrenciKoc"
  yazarId    String // değerlendiren
  hedefId    String // değerlendirilen
  puan       Int      @default(0) // genel puan 1..5
  veri       String   @db.NVarChar(Max) // yapılandırılmış cevaplar (JSON, zod)
  olusturma  DateTime @default(now())
  guncelleme DateTime @default(now()) @updatedAt

  @@unique([ozelDersId, yon])
  @@index([hedefId])
}

// ── Online sınıf ve canlı ders altyapısı ─────────────────────────────────
// Sınıf kalıcı gruptur; DersOturumu o sınıfın belirli tarih/saatteki dersidir.
// Birebir özel dersler de isteğe bağlı ozelDersId ile aynı oturum altyapısını kullanır.

model OnlineSinif {
  id         String           @id @default(cuid())
  ogretmenId String
  ogretmen   Kullanici        @relation("OnlineSinifOgretmen", fields: [ogretmenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ad         String
  ders       String
  seviye     String           @default("")
  aciklama   String           @default("") @db.NVarChar(Max)
  kapasite   Int              @default(20)
  aktif      Boolean          @default(true)
  hatirlatmaDk Int?           // derse kaç dk kala bildirim; null ise MailAyar.dersHatirlatmaDk (global) kullanılır
  olusturma  DateTime         @default(now())
  uyeler     OnlineSinifUye[]
  oturumlar  DersOturumu[]
  videoAtamalari VideoAtama[]

  @@index([ogretmenId, aktif])
}

model OnlineSinifUye {
  id          String      @id @default(cuid())
  sinifId     String
  kullaniciId String
  sinif       OnlineSinif @relation(fields: [sinifId], references: [id], onDelete: Cascade)
  kullanici   Kullanici   @relation(fields: [kullaniciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  katilma     DateTime    @default(now())

  @@unique([sinifId, kullaniciId])
  @@index([kullaniciId])
}

model DersOturumu {
  id             String         @id @default(cuid())
  sinifId        String?
  ozelDersId     String?
  sinif          OnlineSinif?   @relation(fields: [sinifId], references: [id], onDelete: Cascade)
  ozelDers       OzelDers?      @relation(fields: [ozelDersId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  baslik         String
  konu           String         @default("")
  baslangic      DateTime
  sure           Int            @default(60) // planlanan süre (dk)
  canliBaslangic DateTime?      // ders gerçekten "canlı"ya geçtiği an (ilk katılım)
  bitis          DateTime?      // ders "tamamlandı"ya çekildiği an
  gercekSure     Int?           // gerçek süre (dk) = round((bitis - canliBaslangic)/60000)
  durum          String         @default("planlandi") // "planlandi" | "canli" | "tamamlandi" | "iptal"
  hatirlatildi   Boolean        @default(false) // derse-kala bildirimi gönderildi mi (tekrar koruması)
  saglayici      String         @default("livekit")
  saglayiciOdaId String         @unique
  kayitEtkin     Boolean        @default(false) // MVP'de daima false; KVKK süreci sonrası açılacak
  olusturma      DateTime       @default(now())
  katilimlar     DersKatilim[]
  materyaller    DersMateryal[]
  kayitlar       DersKaydi[]

  @@index([sinifId, baslangic])
  @@index([ozelDersId])
  @@index([baslangic, durum])
}

model DersKatilim {
  id          String      @id @default(cuid())
  oturumId    String
  kullaniciId String
  oturum      DersOturumu @relation(fields: [oturumId], references: [id], onDelete: Cascade)
  kullanici   Kullanici   @relation(fields: [kullaniciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ilkKatilma  DateTime?
  sonAyrilma  DateTime?
  toplamSure  Int         @default(0) // saniye
  durum       String      @default("bekleniyor") // "bekleniyor" | "katildi" | "katilmadi"

  @@unique([oturumId, kullaniciId])
  @@index([kullaniciId])
}

model DersMateryal {
  id        String      @id @default(cuid())
  oturumId  String
  oturum    DersOturumu @relation(fields: [oturumId], references: [id], onDelete: Cascade)
  ad        String
  adres     String      @db.NVarChar(Max)
  tur       String      @default("baglanti")
  olusturma DateTime    @default(now())

  @@index([oturumId])
}

model DersKaydi {
  id          String      @id @default(cuid())
  oturumId    String
  oturum      DersOturumu @relation(fields: [oturumId], references: [id], onDelete: Cascade)
  saglayiciId String      @default("")
  adres       String      @default("") @db.NVarChar(Max)
  sure        Int         @default(0)
  durum       String      @default("hazirlaniyor")
  saklamaSonu DateTime?
  olusturma   DateTime    @default(now())

  @@index([oturumId])
}

// ── E-posta altyapısı ────────────────────────────────────────
// MailAyar: tek satırlık SMTP yapılandırması (id her zaman 1).
// MailSablon: anahtarla erişilen, {{degisken}} yer tutuculu şablonlar.
// MailKuyruk: gönderilecek/gönderilen mailler; worker (src/lib/mail-isleyici.ts)
// bekleyenleri periyodik işler, hata alırsa geri-çekilmeli (backoff) tekrar dener.

model MailAyar {
  id             Int      @id @default(1)
  aktif          Boolean  @default(false) // kapalıyken kuyruklama ve gönderim durur
  sunucu         String   @default("") // SMTP sunucusu (örn. smtp.gmail.com)
  port           Int      @default(587)
  guvenli        Boolean  @default(false) // true = SSL/TLS (465), false = STARTTLS (587)
  kullaniciAdi   String   @default("") // SMTP kullanıcı adı
  sifre          String   @default("") // SMTP şifresi / uygulama şifresi
  gonderenAd     String   @default("Kaynak Akademi")
  gonderenAdres  String   @default("") // From adresi
  hatirlatmaSaat   Int      @default(24) // özel ders hatırlatma maili kaç saat önce gönderilsin
  veliRaporAktif   Boolean  @default(false) // açıksa haftalık veli ilerleme raporu otomatik kuyruklanır
  dersHatirlatmaDk Int      @default(15) // online derse kaç dk kala bildirim (sınıf override etmezse)
  guncelleme       DateTime @default(now()) @updatedAt
}

model MailSablon {
  id         String   @id @default(cuid())
  anahtar    String   @unique // "hosgeldin" | "ders-hatirlatma"
  ad         String
  konu       String // {{degisken}} yer tutucular kullanılabilir
  govde      String   @db.NVarChar(Max) // HTML gövde, {{degisken}} yer tutucular
  aktif      Boolean  @default(true) // pasif şablon kuyruklanmaz
  guncelleme DateTime @default(now()) @updatedAt
}

model MailKuyruk {
  id        String    @id @default(cuid())
  alici     String // alıcı e-posta adresi
  aliciAd   String    @default("")
  konu      String
  govde     String    @db.NVarChar(Max) // şablondan doldurulmuş nihai HTML
  durum     String    @default("bekliyor") // "bekliyor" | "gonderildi" | "hata"
  deneme    Int       @default(0)
  sonHata   String    @default("") @db.NVarChar(Max)
  planlanan DateTime  @default(now()) // bu tarihten önce gönderilmez
  gonderim  DateTime? // başarılı gönderim anı
  sablon    String    @default("") // kaynak şablon anahtarı (bilgi amaçlı)
  refTur    String    @default("") // tekrar kuyruklamayı önlemek için kaynak: "kullanici" | "ozelders"
  refId     String    @default("")
  olusturma DateTime  @default(now())

  @@index([durum, planlanan])
  @@index([sablon, refTur, refId])
}

model Bildirim {
  id             String    @id @default(cuid())
  aliciId        String
  alici          Kullanici @relation(fields: [aliciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ikon           String
  metin          String    @db.NVarChar(Max)
  hedefTur       String? // "ozel" | "odev" | "sinif" | "oturum" | "test"
  hedefOgrenciId String?
  hedefKayitId   String?
  tarih          DateTime  @default(now())
  okundu         Boolean   @default(false)

  // Cihaz push'u durumu: bildirim transaction içinde yazılır, push'u
  // mail işleyicisi commit sonrası kuyruktan gönderir (bkz. lib/push-kuyruk.ts).
  // "bekliyor" | "gonderildi" | "atlandi" (tercih kapalı / abonelik yok / süre aştı)
  pushDurum String @default("bekliyor")

  @@index([aliciId, okundu])
  @@index([pushDurum, tarih])
}

// ── Ön mülakat / başvuru sistemi ─────────────────────────────
// Siteye öğretmen/öğrenci/eğitim koçu olarak katılmak isteyenlerin
// doldurduğu ön başvuru formları. Türe göre çok farklı alanlar
// içeren form verisi Basvuru.veri içinde JSON tutulur (zod ile
// doğrulanır — bkz. src/lib/dogrulama-basvuru.ts); listeleme/kart ve
// filtre alanları (ad, tur, durum, telefon, eposta, sehir, tarih)
// gerçek kolonlardır. Başvuran kayıtlı kullanıcı DEĞİLDİR; başvurusunu
// kriptografik takipToken ile /basvuru/durum/<token> sayfasından izler.
// tur teknik değerleri: "ogretmen" | "ogrenci" | "koc" (UI'da "Eğitim Koçu").
model Basvuru {
  id         String   @id @default(cuid())
  tur        String // "ogretmen" | "ogrenci" | "koc"
  durum      String   @default("yeni") // bkz. BASVURU_DURUMLARI (sabitler.ts)
  ad         String // ad soyad — kart/listeleme
  telefon    String   @default("")
  eposta     String   @default("")
  sehir      String   @default("")
  veri       String   @db.NVarChar(Max) // türe özel form verisi (JSON)
  takipToken String   @unique // kriptografik, tahmin edilemez (crypto.randomBytes)
  olusturma  DateTime @default(now())
  guncelleme DateTime @default(now()) @updatedAt

  dosyalar   BasvuruDosya[]
  notlar     BasvuruNot[]
  mulakatlar Mulakat[]

  @@index([tur, durum])
  @@index([olusturma])
}

// Yüklenen belgeler public dışı bir dizinde saklanır; yalnız
// basvuru:yonet yetkili admin, /api/basvuru/dosya/[id] üzerinden erişir.
// Gerçek disk yolu (yol) hiçbir zaman istemciye gönderilmez.
model BasvuruDosya {
  id        String   @id @default(cuid())
  basvuruId String
  basvuru   Basvuru  @relation(fields: [basvuruId], references: [id], onDelete: Cascade)
  alan      String // "profil" | "ozgecmis" | "diploma" | "sertifika" | "ek"
  ad        String // orijinal dosya adı (yalnız görüntüleme için)
  yol       String   @db.NVarChar(1000) // saklama köküne göreli yol (public DIŞI)
  tur       String   @default("") // MIME türü
  boyut     Int      @default(0) // bayt
  olusturma DateTime @default(now())

  @@index([basvuruId])
}

// Yönetici değerlendirme notları — YALNIZ yönetim tarafında görünür,
// başvuranın takip sayfasında asla gösterilmez.
model BasvuruNot {
  id        String   @id @default(cuid())
  basvuruId String
  basvuru   Basvuru  @relation(fields: [basvuruId], references: [id], onDelete: Cascade)
  yazarId   String // notu ekleyen admin (Kullanici modeli sade kalsın diye FK yok)
  yazarAd   String   @default("")
  metin     String   @db.NVarChar(Max)
  olusturma DateTime @default(now())

  @@index([basvuruId])
}

// Bir başvurunun birden çok mülakatı olabilir (erteleme / yeniden
// planlama / birden fazla görüşme). Eski kayıtlar silinmez; aktif=false
// ile geçmişte saklanır. Yeni planlanan görüşme aktif=true olur.
model Mulakat {
  id                         String   @id @default(cuid())
  basvuruId                  String
  basvuru                    Basvuru  @relation(fields: [basvuruId], references: [id], onDelete: Cascade)
  aktif                      Boolean  @default(true) // güncel/aktif görüşme mi
  tarih                      DateTime // görüşme tarih + saati
  sure                       Int      @default(30) // tahmini süre (dk)
  tur                        String   @default("online") // "online" | "telefon" | "yuzyuze"
  baglanti                   String   @default("") @db.NVarChar(1000) // online görüşme bağlantısı
  adres                      String   @default("") @db.NVarChar(1000) // yüz yüze görüşme adresi
  gorusmeci                  String   @default("") // görüşmeyi yapacak kişi
  aciklama                   String   @default("") @db.NVarChar(Max) // başvurana gönderilecek açıklama
  sonuc                      String   @default("") // "" | "yapildi" | "katilmadi" | "yeniden" | "olumlu" | "olumsuz" | "beklemede"
  sonucNotu                  String   @default("") @db.NVarChar(Max)
  hatirlatma24SaatGonderildi Boolean  @default(false) // tarih/saat güncellenince false'a çekilir
  hatirlatma1SaatGonderildi  Boolean  @default(false)
  olusturma                  DateTime @default(now())
  guncelleme                 DateTime @default(now()) @updatedAt

  @@index([basvuruId, aktif])
  @@index([tarih, aktif])
}

// ── Video ders notları ───────────────────────────────────────
// Kayıt altına alınmış ya da önceden hazırlanmış ders videoları. Canlı ders
// altyapısından (DersOturumu/DersKaydi) BAĞIMSIZDIR: videoyu öğretmen ya da
// yönetici yükler, öğrenciye tek tek veya online sınıf üzerinden atar.
//
// Kaynak iki türlü olabilir:
//   kaynakTur="baglanti" → adres (YouTube/Vimeo/doğrudan mp4 bağlantısı)
//   kaynakTur="dosya"    → dosyaYol (public DIŞI dizin; yalnız
//                          /api/video-ders/[id]/akis üzerinden Range destekli
//                          akıtılır, gerçek disk yolu istemciye gitmez)
// Yayın durumu: "taslak" (öğrenciye kapalı) | "yayinda" (listelenir) |
// "gizli" (listelenmez, atanmış öğrenci doğrudan bağlantıyla erişir).
model VideoDers {
  id             String        @id @default(cuid())
  baslik         String
  ders           String
  konu           String        @default("")
  ogretmenId     String
  ogretmen       Kullanici     @relation("VideoDersOgretmen", fields: [ogretmenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  olusturanId    String // videoyu yükleyen (admin ya da öğretmenin kendisi) — denetim için
  aciklama       String        @default("") @db.NVarChar(Max)
  islenenKonular String        @default("") @db.NVarChar(Max) // satır başına bir konu
  ogretmenNotu   String        @default("") @db.NVarChar(Max)
  tarih          DateTime      @db.Date
  sure           Int           @default(0) // dakika
  kaynakTur      String        @default("baglanti") // "baglanti" | "dosya"
  adres          String        @default("") @db.NVarChar(1000) // kaynakTur="baglanti"
  dosyaAd        String        @default("") // orijinal dosya adı (yalnız görüntüleme)
  dosyaYol       String?       @db.NVarChar(1000) // saklama köküne göreli yol (public DIŞI)
  dosyaTur       String        @default("") // MIME
  dosyaBoyut     Int           @default(0) // bayt
  kapakYol       String?       @db.NVarChar(1000)
  kapakTur       String        @default("")
  durum          String        @default("taslak") // "taslak" | "yayinda" | "gizli"
  olusturma      DateTime      @default(now())
  guncelleme     DateTime      @default(now()) @updatedAt
  ekler          VideoEk[]
  atamalar       VideoAtama[]
  gorevler       VideoGorev[]
  izlemeler      VideoIzleme[]

  @@index([ogretmenId, durum])
  @@index([durum, tarih])
}

// Videoya eklenen PDF/doküman/görsel. Dosyalar public DIŞI dizinde tutulur;
// yalnız /api/video-ders/ek/[id] üzerinden yetkili kullanıcıya sunulur.
model VideoEk {
  id        String    @id @default(cuid())
  videoId   String
  video     VideoDers @relation(fields: [videoId], references: [id], onDelete: Cascade)
  ad        String // orijinal dosya adı (yalnız görüntüleme için)
  yol       String    @db.NVarChar(1000) // saklama köküne göreli yol
  tur       String    @default("") // MIME türü
  boyut     Int       @default(0) // bayt
  olusturma DateTime  @default(now())

  @@index([videoId])
}

// Videonun bir öğrenciye ya da bir online sınıfa atanması. İki alandan tam
// olarak biri doludur (zod ile doğrulanır). SQL Server tek NULL'a izin veren
// unique index kullandığı için @@unique YOKTUR; tekrar koruması app tarafında.
model VideoAtama {
  id        String       @id @default(cuid())
  videoId   String
  video     VideoDers    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  ogrenciId String?
  ogrenci   Kullanici?   @relation("VideoAtamaOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sinifId   String?
  sinif     OnlineSinif? @relation(fields: [sinifId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  olusturma DateTime     @default(now())

  @@index([videoId])
  @@index([ogrenciId])
  @@index([sinifId])
}

// Öğretmenin videoya bağladığı görevler — detay sayfasında sırayla listelenir.
model VideoGorev {
  id      String    @id @default(cuid())
  videoId String
  video   VideoDers @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sira    Int       @default(0)
  metin   String    @db.NVarChar(1000)

  @@index([videoId])
}

// Öğrenci başına izleme durumu + kişisel not. Kayıt yoksa durum "izlenmedi"
// sayılır; ilk oynatmada oluşturulur. notlar YALNIZ ilgili öğrenciye gösterilir
// (öğretmen/yönetici arayüzünde hiçbir yerde okunmaz).
model VideoIzleme {
  id         String    @id @default(cuid())
  videoId    String
  ogrenciId  String
  video      VideoDers @relation(fields: [videoId], references: [id], onDelete: Cascade)
  ogrenci    Kullanici @relation("VideoIzlemeOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  durum      String    @default("izlenmedi") // "izlenmedi" | "izleniyor" | "tamamlandi"
  saniye     Int       @default(0) // en son bırakılan konum
  yuzde      Int       @default(0) // izlenen oran (0..100)
  notlar     String    @default("") @db.NVarChar(Max) // öğrencinin kişisel notu
  ilkIzleme  DateTime?
  sonIzleme  DateTime?
  guncelleme DateTime  @default(now()) @updatedAt

  @@unique([videoId, ogrenciId])
  @@index([ogrenciId])
}

/* ── Blog ─────────────────────────────────────────────────────
   Herkese açık içerik modülü. Kullanıcı sistemine BAĞLI DEĞİLDİR:
   yazar serbest metindir (yazarAd), Kullanici'ye FK yoktur — böylece
   yazar hesabı silinse bile yayın etkilenmez ve ziyaretçi oturum
   olmadan okur. Bağlantı adresi `slug` üzerinden kurulur (/blog/<slug>).
   Kapak görseli public DIŞI dizinde tutulur; /api/blog/kapak/[id]
   üzerinden sunulur. */
model BlogYazi {
  id          String    @id @default(cuid())
  slug        String    @unique // SEO adresi — /blog/<slug>
  baslik      String
  ozet        String    @default("") @db.NVarChar(1000) // kartlarda görünen kısa açıklama
  icerik      String    @default("") @db.NVarChar(Max) // markdown-lite (bkz. lib/blog.ts)
  kategori    String // BLOG_KATEGORILERI anahtarı
  etiketler   String    @default("") @db.NVarChar(1000) // virgülle ayrılmış
  seoAciklama String    @default("") @db.NVarChar(1000) // meta description
  yazarAd     String    @default("") // serbest metin; kullanıcı kaydına bağlanmaz
  kapakYol    String?   @db.NVarChar(1000) // saklama köküne göreli (public DIŞI)
  kapakTur    String    @default("") // MIME
  kapakAd     String    @default("") // orijinal dosya adı (yalnız görüntüleme)
  durum       String    @default("taslak") // "taslak" | "yayinda"
  yayinTarihi DateTime? // yayına alındığı an; taslakta null
  okuma       Int       @default(0) // tahmini okuma süresi (dakika)
  olusturma   DateTime  @default(now())
  guncelleme  DateTime  @default(now()) @updatedAt

  @@index([durum, yayinTarihi])
  @@index([kategori, durum])
}

/* ── Ödemeler ─────────────────────────────────────────────────
   Bir satır = bir ödeme kalemi. İKİ bacağı vardır ve bacaklar birbirinden
   bağımsız yürür:
     · öğrenci bacağı  → ogrenciTutar / ogrenciDurum / ogrenciOdemeTarihi
     · öğretmen bacağı → kocTutar / kocDurum / kocOdemeTarihi
   Platformda kalan tutar SAKLANMAZ, ogrenciTutar - kocTutar olarak
   hesaplanır (bkz. lib/odeme.ts platformPayi).

   GİZLİLİK — modülün varlık nedeni: hiçbir rol karşı bacağın FİNANSAL
   alanlarını görmez.
     · öğrenci  yalnız kendi satırlarının öğrenci bacağını,
     · öğretmen yalnız kendi satırlarının öğretmen bacağını (+ ödemenin
       hangi öğrenci için olduğunu gösteren ad),
     · yönetici tümünü görür.
   Bu ayrım tek yerden, lib/odeme.ts içindeki alan listeleriyle (select)
   uygulanır; sorgular kolonu hiç çekmez — sayfa/istemcide filtreleme YOK.

   Tutarlar tam TL'dir (Int); OzelDers.ucret ile aynı birim.
   Kullanici'ye FK'ler NoAction (SQL Server çoklu-cascade tuzağı); silme
   app tarafında $transaction ile yapılır (bkz. actions/admin.ts). */
model Odeme {
  id        String     @id @default(cuid())
  ogrenciId String
  ogrenci   Kullanici  @relation("OdemeOgrenci", fields: [ogrenciId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kocId     String? // öğretmen payı olmayan kalemde (örn. platform paketi) boş
  koc       Kullanici? @relation("OdemeKoc", fields: [kocId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  aciklama String   @default("") @db.NVarChar(1000) // her iki tarafın gördüğü kalem açıklaması
  tarih    DateTime @db.Date // ödeme / vade tarihi

  ogrenciTutar       Int       @default(0) // öğrencinin platforma ödediği (öğretmene GÖSTERİLMEZ)
  ogrenciDurum       String    @default("bekliyor") // "bekliyor" | "odendi" | "iptal"
  ogrenciOdemeTarihi DateTime? @db.Date // tahsil edildiği gün
  yontem             String    @default("") // "" | "havale" | "kart" | "nakit" | "diger"

  kocTutar       Int       @default(0) // öğretmene ödenecek (öğrenciye GÖSTERİLMEZ)
  kocDurum       String    @default("bekliyor") // "bekliyor" | "hazirlaniyor" | "odendi"
  kocOdemeTarihi DateTime? @db.Date // öğretmene ödendiği gün

  yoneticiNotu String   @default("") @db.NVarChar(Max) // YALNIZ yönetici görür
  olusturma    DateTime  @default(now())
  guncelleme   DateTime  @default(now()) @updatedAt

  @@index([ogrenciId, tarih])
  @@index([kocId, kocDurum])
  @@index([ogrenciDurum, tarih])
}
