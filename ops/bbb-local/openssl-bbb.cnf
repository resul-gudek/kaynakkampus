[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = distinguished_name
req_extensions = req_extensions

[distinguished_name]
C = TR
ST = Istanbul
L = Istanbul
O = Kaynak Akademi
OU = Yerel Pilot
CN = bbb.localhost

[req_extensions]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = bbb.localhost
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
