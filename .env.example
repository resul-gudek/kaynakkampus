# SQL Server bağlantısı (JDBC benzeri sözdizimi — URL değil!)
# Yerel/self-signed sunucuda trustServerCertificate=true şart.
DATABASE_URL="sqlserver://127.0.0.1:1433;database=kaynakakademi;user=sa;password=DEGISTIR;encrypt=true;trustServerCertificate=true"
# prisma migrate dev için önceden oluşturulmuş gölge veritabanı
SHADOW_DATABASE_URL="sqlserver://127.0.0.1:1433;database=kaynakakademi_shadow;user=sa;password=DEGISTIR;encrypt=true;trustServerCertificate=true"

# Auth.js — `npx auth secret` ile üretilebilir
AUTH_SECRET="DEGISTIR"
AUTH_TRUST_HOST=true

# Uygulamanın dışarıdan erişilen adresi — mail şablonlarındaki {{panelAdresi}}
# değişkeninde kullanılır (varsayılan: http://localhost:37337)
# UYGULAMA_URL="https://panel.kaynakakademi.com"

# LiveKit canlı ders sağlayıcısı (self-hosted). Üçü birlikte verilmeden ders odası açılmaz.
# LIVEKIT_URL: sunucunun WebSocket adresi — tarayıcıya da bu adres gönderilir.
# Yerel geliştirme için: ops/livekit-local/README.md (docker compose up)
# Yerelde "localhost" değil 127.0.0.1 kullanın: WSL port yönlendirmesi IPv6 (::1)
# dinlemediği için tarayıcı websocket bağlantısı localhost ile başarısız olur.
# LIVEKIT_URL="ws://127.0.0.1:7880"
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="DEGISTIR"

# Loglama (opsiyonel)
# LOG_LEVEL: trace|debug|info|warn|error (varsayılan: dev'de debug, prod'da info)
# LOG_DOSYA: verilirse loglar konsola ek olarak bu dosyaya JSON satırları olarak yazılır
# LOG_LEVEL=info
# LOG_DOSYA=logs/uygulama.log
