# SQL Server bağlantısı (JDBC benzeri sözdizimi — URL değil!)
# Yerel/self-signed sunucuda trustServerCertificate=true şart.
DATABASE_URL="sqlserver://127.0.0.1:1433;database=kaynakakademi;user=sa;password=DEGISTIR;encrypt=true;trustServerCertificate=true"
# prisma migrate dev için önceden oluşturulmuş gölge veritabanı
SHADOW_DATABASE_URL="sqlserver://127.0.0.1:1433;database=kaynakakademi_shadow;user=sa;password=DEGISTIR;encrypt=true;trustServerCertificate=true"

# Auth.js — `npx auth secret` ile üretilebilir
AUTH_SECRET="DEGISTIR"
AUTH_TRUST_HOST=true

# Uygulamanın dışarıdan erişilen adresi — mail şablonlarındaki {{panelAdresi}}
# değişkeninde kullanılır (varsayılan: http://localhost:37337)
# UYGULAMA_URL="https://panel.kaynakakademi.com"

# LiveKit canlı ders sağlayıcısı (self-hosted). Üçü birlikte verilmeden ders odası açılmaz.
# LIVEKIT_URL: sunucunun WebSocket adresi — tarayıcıya da bu adres gönderilir.
# Yerel geliştirme için: ops/livekit-local/README.md (docker compose up)
# Yerelde "localhost" değil 127.0.0.1 kullanın: WSL port yönlendirmesi IPv6 (::1)
# dinlemediği için tarayıcı websocket bağlantısı localhost ile başarısız olur.
# LIVEKIT_URL="ws://127.0.0.1:7880"
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="DEGISTIR"

# Web Push (mobil/masaüstü push bildirimleri — online ders hatırlatmaları)
# Anahtarlar: `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# Üçü de verilmezse push devre dışı kalır (uygulama içi bildirim yine çalışır).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: istemciye gönderilen açık anahtar (public).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="DEGISTIR"
# VAPID_PRIVATE_KEY="DEGISTIR"
# VAPID_SUBJECT="mailto:admin@kaynakakademi.com"

# Yüklenen dosyaların saklanacağı dizin (başvuru belgeleri "basvuru/", ödev
# tamamlama fotoğrafları "odev/", ders videoları + kapak/ek dosyaları
# "video-ders/<videoId>/" alt klasörüne yazılır).
# NOT: ders videoları büyüktür (dosya başına en çok 512 MB — bkz.
# MAX_VIDEO_BOYUT, src/lib/dosya-tanim.ts); bu dizin yeterli boş alana sahip
# olmalıdır. Video yalnız /api/video-ders/[id]/akis üzerinden akıtılır.
# Public dizinin DIŞINDA, KALICI bir birim olmalıdır; dosyalar yalnız yetkili
# kullanıcıya API üzerinden sunulur (/api/basvuru/dosya/[id],
# /api/odev/kanit/[id], /api/video-ders/[id]/akis).
# Verilmezse proje kökündeki "veri-yukleme/" kullanılır.
# ÖNEMLİ: Yayın ortamı geçici dosya sistemine sahipse (serverless/ephemeral),
# burayı kalıcı bir birime (kalıcı disk/volume) yönlendirin; aksi halde
# yüklenen dosyalar yeniden dağıtım/yeniden başlatmada kaybolur.
# YUKLEME_DIZINI="/var/lib/kaynak/yuklemeler"
# Eski ad — hâlâ okunur (YUKLEME_DIZINI verilmediyse):
# BASVURU_YUKLEME_DIZINI="/var/lib/kaynak/basvuru-belgeleri"

# Loglama (opsiyonel)
# LOG_LEVEL: trace|debug|info|warn|error (varsayılan: dev'de debug, prod'da info)
# LOG_DOSYA: verilirse loglar konsola ek olarak bu dosyaya JSON satırları olarak yazılır
# LOG_LEVEL=info
# LOG_DOSYA=logs/uygulama.log
